<antlib xmlns:current="ant:current">
    <taskdef 
        name="junit5" 
        classname="com.carrotsearch.ant.tasks.junit5.JUnit5" />

    <taskdef 
        name="mergehints" 
        classname="com.carrotsearch.ant.tasks.junit5.balancers.MergeHints" />

    <taskdef 
        name="tophints" 
        classname="com.carrotsearch.ant.tasks.junit5.balancers.TopHints" />

    <taskdef 
        name="pickseed" 
        classname="com.carrotsearch.ant.tasks.junit5.PickSeedTask" />
    
    <taskdef 
        name="pickfromlist" 
        classname="com.carrotsearch.ant.tasks.junit5.PickFromListTask" />

    <!-- TestBalancers -->

    <typedef
        name="execution-times" 
        classname="com.carrotsearch.ant.tasks.junit5.balancers.ExecutionTimeBalancer" />

    <!-- Listeners and reports -->

    <typedef
        name="report-console" 
        classname="com.carrotsearch.ant.tasks.junit5.listeners.TextReport" />

    <typedef
        name="report-text" 
        classname="com.carrotsearch.ant.tasks.junit5.listeners.TextReport" />

    <typedef
        name="report-ant-xml" 
        classname="com.carrotsearch.ant.tasks.junit5.listeners.antxml.AntXmlReport" />

    <typedef
        name="report-json" 
        classname="com.carrotsearch.ant.tasks.junit5.listeners.json.JsonReport" />

    <typedef
        name="report-execution-times" 
        classname="com.carrotsearch.ant.tasks.junit5.listeners.ExecutionTimesReport" />

    <!-- RunListeners -->
    <typedef
        name="run-listener"
        classname="com.carrotsearch.ant.tasks.junit5.runlisteners.RunListenerClass" />

    <!-- Misc data types -->
    <typedef
        name="duplicate"
        classname="com.carrotsearch.ant.tasks.junit5.DuplicateResources" />

    <typedef
        name="filtertrace" 
        classname="com.carrotsearch.ant.tasks.junit5.listeners.StackTraceFilter" />        
</antlib> 